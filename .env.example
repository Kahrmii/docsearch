# Copy this file to ".env" (next to docker-compose.yml) and fill in the values.
# NEVER commit the ".env" file (it is listed in .gitignore).

# Password of the Elasticsearch user "elastic". Choose a long random password, for example:
#   PowerShell:   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | % {[char]$_})
#   Linux/macOS:  openssl rand -hex 24
ELASTIC_PASSWORD=PUT_A_LONG_RANDOM_PASSWORD_HERE

# --- Only for docker compose (memory, guidelines for 16 GB RAM) ---
# ES_HEAP at most half of ES_MEM_LIMIT.
ES_HEAP=4g
ES_MEM_LIMIT=6g
TIKA_MEM_LIMIT=4g
ES_VERSION=8.15.3
TIKA_VERSION=latest-full
# Reuse the index of an earlier setup: name of its Docker volume (and cluster name), see "docker volume ls".
# The password of that setup must be used as ELASTIC_PASSWORD, because the volume remembers it.
#ES_DATA_VOLUME=docsearch_es_data
#ES_CLUSTER_NAME=docsearch-local

# --- Text extraction and indexing ---
# Languages Tesseract uses for OCR of scans, joined with "+" (the language packs must exist in the Tika image):
#OCR_LANGUAGES=eng
#OCR_LANGUAGES=deu+eng
# Elasticsearch analyzer for the text of NEW indices (stemming, stop words): standard, english, german, french, ...
# Existing indices keep the analyzer they were created with.
#TEXT_ANALYZER=standard

# --- Optional: local LLM server for the questions (OpenAI-compatible, e.g. LM Studio) ---
# Only localhost addresses are allowed.
#LLM_BASE_URL=http://localhost:1234
#LLM_MODEL=qwen/qwen3-14b
# 1 = thinking mode of Qwen3 (more accurate, much slower)
#LLM_THINK=0

# --- Optional: cloud mode (Claude by Anthropic) ---
# WARNING: In cloud mode text excerpts from your documents are sent to the Anthropic API (api.anthropic.com),
# but only for indices you explicitly approve (window: tick "Allow cloud for this index",
# command line: python ask.py --index NAME --allow-cloud). The default is "blocked".
# Enter the key only here, never put it into the repository or a chat.
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-5-5
# Default provider for ask.py: local or anthropic
#LLM_PROVIDER=local

# --- Optional: default folder for "python index.py" without a folder argument ---
#DATA_DIR=C:/path/to/your/documents
